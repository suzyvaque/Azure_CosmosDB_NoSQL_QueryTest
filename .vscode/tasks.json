			"label": "Verify custom fallback telemetry",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd",
			"args": [
				"monitor",
				"log-analytics",
				"query",
				"--workspace",
				"3ae421ff-97b2-46d6-be05-ed062575d7da",
				"--analytics-query",
				"AppEvents | where TimeGenerated between (datetime(2026-09-17T17:15:00Z) .. datetime(2026-09-17T17:20:00Z)) | where Name == 'CosmosQueryPlanFallback' | project TimeGenerated, Name, Properties, Measurements | order by TimeGenerated asc",
				"--output",
				"json",
				"--only-show-errors"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
