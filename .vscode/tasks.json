			"label": "Inspect custom telemetry",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd",
			"args": [
				"monitor",
				"log-analytics",
				"query",
				"--workspace",
				"3ae421ff-97b2-46d6-be05-ed062575d7da",
				"--analytics-query",
				"AppEvents | where TimeGenerated between (datetime(2026-09-17T17:15:00Z) .. datetime(2026-09-17T17:20:00Z)) | take 30",
				"--output",
				"json",
				"--only-show-errors"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify exclusion logic",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd",
			"args": [
				"monitor",
				"log-analytics",
				"query",
				"--workspace",
				"3ae421ff-97b2-46d6-be05-ed062575d7da",
				"--analytics-query",
				"AppEvents | where TimeGenerated between (datetime(2026-09-17T17:15:00Z) .. datetime(2026-09-17T17:25:00Z)) | where Name has CosmosQueryPlanFallback | extend Cosmos = parse_json(Properties) | extend StatusCode = toint(Cosmos.statusCode), SubstatusCode = toint(Cosmos.substatusCode) | summarize FallbackEvents = sum(ItemCount), Identified400_1004 = sumif(ItemCount, StatusCode == 400 and SubstatusCode == 1004), ErrorsAfterExclusion = sumif(ItemCount, StatusCode >= 400 and not(StatusCode == 400 and SubstatusCode == 1004))",
				"--output",
				"json",
				"--only-show-errors"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify 400 1004 exclusion result",
			"type": "shell",
			"command": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd",
			"args": [
				"monitor",
				"log-analytics",
				"query",
				"--workspace",
				"3ae421ff-97b2-46d6-be05-ed062575d7da",
