				"AppEvents | where TimeGenerated between (datetime(2026-09-17T17:15:00Z) .. datetime(2026-09-17T17:25:00Z)) | extend Cosmos = parse_json(Properties) | extend StatusCode = toint(Cosmos.statusCode), SubstatusCode = toint(Cosmos.substatusCode) | where StatusCode == 400 and SubstatusCode == 1004 | summarize FallbackEvents = sum(ItemCount), ErrorsAfterExclusion = sumif(ItemCount, StatusCode >= 400 and not(StatusCode == 400 and SubstatusCode == 1004))",
				"--output",
				"json",
				"--only-show-errors"
			],
			"isBackground": false,
			"problemMatcher": [],
