				"3ae421ff-97b2-46d6-be05-ed062575d7da",
				"--analytics-query",
				"CDBDataPlaneRequests | where TimeGenerated between (datetime(2026-09-17T17:04:00Z) .. datetime(2026-09-17T17:08:00Z)) | where StatusCode == 400 and SubStatusCode == 1004 | project TimeGenerated, OperationName, StatusCode, SubStatusCode, RequestCharge, DurationMs, ActivityId | order by TimeGenerated asc",
