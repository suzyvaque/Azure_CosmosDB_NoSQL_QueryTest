// CDBDataPlaneRequests resource-specific schema does NOT contain SubStatusCode.
// It can show the 400 request, but cannot distinguish 400/1004 from another 400.

// 1) Native Cosmos diagnostics: all 400 responses and their server duration.
CDBDataPlaneRequests
| where StatusCode == 400
| project TimeGenerated, OperationName, StatusCode, RequestCharge, DurationMs,
          ActivityId, ConnectionMode, ClientIpAddress
| order by TimeGenerated desc

// 2) Custom application telemetry: SDK-instrumented query-plan fallbacks.
// This works because the client telemetry explicitly preserves substatusCode.
AppEvents
| where Name in ("CosmosQueryPlanFallback", "CosmosRequest")
| extend Cosmos = parse_json(Properties)
| extend StatusCode = toint(Cosmos.statusCode),
         SubstatusCode = toint(Cosmos.substatusCode),
         ExpectedQueryPlanFallback = tostring(Cosmos.expectedQueryPlanFallback)
| project TimeGenerated, Name, StatusCode, SubstatusCode,
          ExpectedQueryPlanFallback, Measurements, Cosmos
| order by TimeGenerated desc

// 3) Dashboard query: aggregate only actionable failures.
AppEvents
| where Name in ("CosmosQueryPlanFallback", "CosmosRequest")
| extend Cosmos = parse_json(Properties)
| extend StatusCode = toint(Cosmos.statusCode), SubstatusCode = toint(Cosmos.substatusCode)
| where StatusCode >= 400
| where not(StatusCode == 400 and SubstatusCode == 1004)
| summarize ErrorCount = sum(ItemCount) by bin(TimeGenerated, 5m), StatusCode, SubstatusCode
| order by TimeGenerated desc

// 4) Scheduled-query alert: the expected 400/1004 results in AggregatedValue = 0.
AppEvents
| where Name in ("CosmosQueryPlanFallback", "CosmosRequest")
| where TimeGenerated >= ago(5m)
| extend Cosmos = parse_json(Properties)
| extend StatusCode = toint(Cosmos.statusCode), SubstatusCode = toint(Cosmos.substatusCode)
| where StatusCode >= 400
| where not(StatusCode == 400 and SubstatusCode == 1004)
| summarize AggregatedValue = sum(ItemCount)
